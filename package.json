{
  "name": "gancube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "postinstall": "patch-package",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "start": "node server/index.mjs",
    "setup:tnoodle": "node scripts/setup-tnoodle.mjs",
    "db:backup": "node scripts/database.mjs backup",
    "db:restore": "node scripts/database.mjs restore",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs :app:assembleSideload",
    "android:test": "node scripts/build-android.mjs :app:testDebugUnitTest",
    "android:lint": "node scripts/build-android.mjs :app:lintDebug",
    "audit:android": "npm audit && node scripts/build-android.mjs :app:writeRuntimeDependencyReport && node scripts/audit-android.mjs",
    "android:build:debug": "npm run android:sync && node scripts/build-android.mjs :app:assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "gan-web-bluetooth": "3.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/web-bluetooth": "0.0.21",
    "jsdom": "30.1.3",
    "patch-package": "8.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "express": "5.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "gan-web-bluetooth": {
      "rxjs": "7.8.2",
      "aes-js": "3.1.2"
    }
  }
}
